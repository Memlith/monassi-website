#!/usr/bin/env bash
set -euo pipefail

echo "=========================================================="
echo "🔒 [Pre-Commit Hook] Monassi Móveis Planejados"
echo "=========================================================="

# 1. Converte novas imagens .jpg/.jpeg/.png em public/img/ para .webp comprimido
echo "👉 Etapa 1/3: Otimizando e convertendo imagens para WebP..."
npm run optimize:images

# Se imagens foram convertidas ou referências atualizadas, adiciona ao stage do git
git add public/img app components lib 2>/dev/null || true

# 2. Roda a suíte de testes (ESLint, TypeScript, Integridade de Imagens, Catálogo e Firestore Rules)
echo "👉 Etapa 2/3: Executando suíte de testes (npm test)..."
npm test

# 3. Roda o build de produção do Next.js
echo "👉 Etapa 3/3: Executando build de produção (npm run build)..."
npm run build

echo "=========================================================="
echo "✅ [Pre-Commit] Tudo validado com sucesso! Prosseguindo..."
echo "=========================================================="
